        "custom_liquid": "{% if customer %}\n<script>window.SHOPIFY_TEACHER={email:{{ customer.email | json }},tags:{{ customer.tags | join: \", \" | json }},firstName:{{ customer.first_name | json }}};</script>\n{% endif %}\n{{ 'lqk-portal.css' | asset_url | stylesheet_tag }}\n\n<div class=\"wrap\">\n  <div class=\"gate\" id=\"gate\">\n    <div class=\"bism\">بِسْمِ اللَّهِ الرَّحْمَٰنِ الرَّحِيمِ</div>\n    <div class=\"gate-logo\">Little Quran Kids</div>\n    <h1>Teacher Portal</h1>\n    <img class=\"gate-img\" src=\"{{ 'lqk-gate.png' | asset_url }}\" alt=\"Little Quran Kids\">\n    <p id=\"gateMsg\">Staff only — log in to open the register</p>\n    <a class=\"gate-login-btn\" href=\"{{ routes.account_login_url }}\">\n      <svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2\"></path><circle cx=\"12\" cy=\"7\" r=\"4\"></circle></svg>\n      Log in with teacher account\n    </a>\n    <div class=\"gate-divider\" id=\"gateDivider\">or use PIN</div>\n    <input class=\"gate-pin\" id=\"pinIn\" type=\"password\" inputmode=\"numeric\" maxlength=\"8\" placeholder=\"Enter PIN\" aria-label=\"PIN\">\n    <button class=\"gate-pin-btn\" id=\"pinGo\">Enter with PIN</button>\n    <div class=\"err\" id=\"pinErr\"></div>\n  </div>\n\n  <header>\n    <div class=\"bism-hdr\">بِسْمِ اللَّهِ الرَّحْمَٰنِ الرَّحِيمِ</div>\n    <div class=\"hdr-row\">\n      <div style=\"min-width:0;flex:1\">\n        <span class=\"lqk-label\">Little Quran Kids</span>\n        <div class=\"hdr-welcome\" id=\"hdrWelcome\">Welcome</div>\n        <div class=\"cls-name\" id=\"clsName\">—</div>\n      </div>\n      <div class=\"hdr-right\">\n        <div class=\"hdr-date\" id=\"hdrDate\">—</div>\n        <div class=\"hdr-links\" id=\"hdrLinks\" style=\"display:none\"><a class=\"hdr-logout\" href=\"{{ routes.account_logout_url }}\">Log out</a></div>\n      </div>\n      <img class=\"hdr-av\" id=\"hdrAvatar\" style=\"display:none\" alt=\"\">\n    </div>\n    <div class=\"prayer-bar\" id=\"prayerBar\">\n      <div class=\"pr-row\" id=\"prTimings\"></div>\n      <div class=\"pr-countdown\"><span class=\"pr-cd-label\" id=\"prNextName\"></span><span class=\"pr-cd-time\" id=\"prCountdown\">--:--</span><span class=\"pr-cd-hint\" id=\"prNextHint\"></span></div>\n    </div>\n    <div class=\"geo\"></div>\n  </header>\n  <div class=\"sumbar\">\n    <div class=\"sg\"><b id=\"tLogged\">0/0</b>Logged</div>\n    <div class=\"sg2\"><b id=\"tJuz\">—</b>Avg juz</div>\n    <div class=\"sync\" id=\"sync\"><span class=\"dot\"></span><span id=\"syncTxt\">—</span></div>\n  </div>\n  <div class=\"pills\" id=\"pills\"></div>\n  <div class=\"ayah-bar\" id=\"ayahBar\"><div class=\"ayah-title\">One Quran Ayat a Day</div><div class=\"ayah-ar\" id=\"ayahAr\">…</div><div class=\"ayah-ref\" id=\"ayahRef\"></div></div>\n  <div class=\"demo-bar\" id=\"demoBar\" style=\"display:none\">Demo mode — tap any student to try the lesson sheet.</div>\n\n  <main>\n    <div class=\"hint\">Tap a student to view their progress and log today's lesson.</div>\n    <div id=\"roster\"><div class=\"loading\">Loading…</div></div>\n  </main>\n  <div class=\"proto\">Little Quran Kids · Teacher Portal</div>\n</div>\n\n<!-- Student detail panel -->\n<div class=\"panel-wrap\" id=\"panelWrap\">\n  <div class=\"panel\" id=\"panel\">\n    <div class=\"panel-top\">\n      <div>\n        <div class=\"pt-name\" id=\"ptName\">—</div>\n        <div class=\"pt-sub\" id=\"ptSub\">—</div>\n      </div>\n      <button class=\"cls-btn\" id=\"panelClose\" aria-label=\"Close\">✕</button>\n    </div>\n    <div id=\"panelBody\"></div>\n  </div>\n</div>\n\n<!-- Lesson sheet -->\n<div class=\"sheet-wrap\" id=\"sheetWrap\" role=\"dialog\" aria-modal=\"true\">\n  <div class=\"sheet\">\n    <div class=\"sheet-top\">\n      <div><div class=\"sh-title\" id=\"shName\">—</div><div class=\"sh-sub\" id=\"shSub\">—</div></div>\n      <button class=\"cls-btn\" id=\"shClose\" aria-label=\"Close\">✕</button>\n    </div>\n    <div class=\"chipbar\" id=\"lastBar\" style=\"display:none\">\n      <span class=\"chip\" id=\"lastChip\"></span>\n      <button class=\"chip\" id=\"contBtn\">Continue ›</button>\n    </div>\n    <div class=\"block\">\n      <div class=\"bhead\"><h3>Today's portion</h3><span class=\"wh\">Pick from the Quran</span></div>\n      <div class=\"qrow\"><select id=\"selJuz\" aria-label=\"Jump to juz\"></select><select id=\"selSurah\" aria-label=\"Surah\"></select></div>\n      <div class=\"qrow\"><select id=\"selFrom\" aria-label=\"From ayah\"></select><select id=\"selTo\" aria-label=\"To ayah\"></select></div>\n      <div class=\"prev\" id=\"qPrev\"><div class=\"ref\">Select a surah and ayah range</div></div>\n      <div class=\"grades\" data-g=\"sabaq\">\n        <button class=\"g-exc\">Excellent</button>\n        <button class=\"g-pass\">Pass</button>\n        <button class=\"g-rep\">Repeat</button>\n      </div>\n\n    </div>\n    <div class=\"block\">\n      <div class=\"bhead\"><h3>Note to student</h3><span class=\"wh\">Optional</span></div>\n      <textarea id=\"noteField\" rows=\"3\" placeholder=\"Write a note or comment for the student…\" aria-label=\"Note to student\"></textarea>\n    </div>\n    <button class=\"save-btn\" id=\"shSave\">Save &amp; share lesson</button>\n  </div>\n</div>\n\n<!-- Share card (captured off-screen) -->\n<div class=\"share-card\" id=\"shareCard\" aria-hidden=\"true\">\n  <div class=\"sc-bism\">بِسْمِ اللَّهِ الرَّحْمَٰنِ الرَّحِيمِ</div>\n  <div class=\"sc-name\" id=\"scName\"></div>\n  <div class=\"sc-date\" id=\"scDate\"></div>\n  <div class=\"sc-div\"></div>\n  <div class=\"sc-surah\" id=\"scSurah\"></div>\n  <div class=\"sc-row\"><span class=\"sc-label\">Grade</span><span class=\"sc-val\" id=\"scGrade\"></span></div>\n  <div class=\"sc-note\" id=\"scNote\"></div>\n  <div class=\"sc-div\"></div>\n  <div class=\"sc-foot\">Little Quran Kids · littlequrankids.sg</div>\n</div>\n\n<div class=\"toast\" id=\"toast\"><span class=\"tdot\"></span><span id=\"toastTxt\"></span></div>\n\n<script src=\"https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js\"></script>\n<script src=\"{{ 'lqk-portal.js' | asset_url }}\"></script>",
